    {
      "parameters": {
        "jsCode": "\n// Encerra conversas por falta de interação, conforme a etapa do funil.\n// Contato 10min | Atendendo 30min | Negociando 30min | Rastreio: NUNCA fecha.\nconst LIMITES = { contato: 10, atendendo: 30, negociando: 30 };\n\nconst ESTAGIO_TO_ETAPA = {\n  em_atendimento: 'atendendo',\n  convenio_nao_legivel: 'negociando',\n  convenio_legivel: 'negociando',\n  em_avaliacao_hsm: 'negociando',\n  vaga_cedida: 'rastreio',          // Rastreio: nao fecha\n  internado: 'internacao',\n  vaga_recusada_medico: 'perdido',\n  recusou_origem: 'perdido',\n  recusou_internacao: 'perdido',\n  sem_condicoes_financeiras: 'perdido',\n};\n\n// indexa as triagens por conversation_id\nconst triagens = {};\nfor (const it of $('Buscar triagens').all()) {\n  const r = it.json || {};\n  if (r.conversation_id != null) triagens[String(r.conversation_id)] = r;\n}\n\nconst agora = Math.floor(Date.now() / 1000);\nconst out = [];\n\nfor (const item of $input.all()) {\n  const body = item.json || {};\n  const lista = (body.data && body.data.payload) || body.payload || [];\n  for (const c of lista) {\n    const id = String(c.id);\n    const t = triagens[id];\n    const etapa = t ? (ESTAGIO_TO_ETAPA[t.estagio_funil] || 'contato') : 'contato';\n    const limite = LIMITES[etapa];\n    if (!limite) continue;                     // rastreio/internacao/perdido: nao fecha\n    const last = Number(c.last_activity_at || c.timestamp || 0);\n    if (!last) continue;\n    const minutos = (agora - last) / 60;\n    if (minutos >= limite) {\n      out.push({ json: { conversation_id: id, etapa, minutos: Math.round(minutos), limite, custom_attributes: c.custom_attributes || {} } });\n    }\n  }\n}\nreturn out;\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "id": "calc-0001-0001-0001-000000000004",
