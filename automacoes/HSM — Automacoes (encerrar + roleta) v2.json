    {
      "parameters": {
        "jsCode": "\n// ROLETA: distribui conversas SEM atendente entre os atendentes, por ordem de chegada.\n// Ordem de chegada = ordem crescente do id da conversa. Round-robin sequencial.\nconst ATENDENTES = [6, 7, 8, 9]; // Angela, Kaylane, Larissa, Natali\n\nconst semAtendente = [];\nfor (const item of $input.all()) {\n  const body = item.json || {};\n  const lista = (body.data && body.data.payload) || body.payload || [];\n  for (const c of lista) {\n    const assignee = c.meta && c.meta.assignee;\n    if (!assignee || !assignee.id) semAtendente.push(c);\n  }\n}\n// ordem de chegada\nsemAtendente.sort((a, b) => Number(a.id) - Number(b.id));\n\nreturn semAtendente.map((c, i) => ({\n  json: { conversation_id: String(c.id), assignee_id: ATENDENTES[i % ATENDENTES.length] },\n}));\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        220
      ],
