# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Chatwoot (API — servidor)
CHATWOOT_BASE_URL=
CHATWOOT_API_TOKEN=
CHATWOOT_ACCOUNT_ID=1
# Segredo do webhook Chatwoot → app (obrigatório em produção; header x-webhook-secret ou ?secret=)
CHATWOOT_WEBHOOK_SECRET=
# Nome do usuário do bot no Chatwoot (mensagens dele não pausam o bot)
CHATWOOT_BOT_NAME=Moniquinha
# Regra 12: não encerra conversa sem Venda=Sim ou Motivo de perda (1 = ligado)
CHATWOOT_EXIGIR_DESFECHO=1
# Assuntos isentos da regra 12 (ex.: consulta,administrativo). Vazio = todos exigem desfecho.
CHATWOOT_DESFECHO_ASSUNTOS_ISENTOS=

# Chatwoot (links no navegador)
NEXT_PUBLIC_CHATWOOT_BASE_URL=
NEXT_PUBLIC_CHATWOOT_ACCOUNT_ID=1

# Database Webhook Supabase (triagem_hsm INSERT/UPDATE) → /api/sync/triagem (header x-sync-secret)
SYNC_WEBHOOK_SECRET=
# Cron (/api/cron/automacoes, Authorization: Bearer ...) — só faz algo com N8N_ATIVO=0
CRON_SECRET=

# n8n: 1 = n8n continua responsável por bot/1º contato/encerramento (padrão)
#      0 = "modo sem n8n": o app assume essas tarefas
N8N_ATIVO=1
# (A distribuição de conversas é da atribuição automática NATIVA do Chatwoot —
#  Configurações → Caixas de entrada → Atribuição automática. O app não atribui.)
# Inatividade (min) por etapa para encerrar automaticamente (modo sem n8n)
INATIVIDADE_CONTATO_MIN=10
INATIVIDADE_ATENDENDO_MIN=30
INATIVIDADE_NEGOCIANDO_MIN=30

# Bot Mônica dentro do app (modo sem n8n). Exige N8N_ATIVO=0.
BOT_ENABLED=0
OPENAI_API_KEY=
BOT_MODEL=gpt-4.1-mini
BOT_VISION_MODEL=gpt-4o-mini
BOT_EMBEDDING_MODEL=text-embedding-3-small

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Caixas do Chatwoot que o CRM ignora (nao viram lead), ids separados por virgula
CHATWOOT_INBOXES_IGNORADAS=
