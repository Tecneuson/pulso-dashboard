      "id": "bbb00001-0001-4000-8000-000000000002",
      "name": "Buscar Plano de Saúde",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [260, 300]
    },
    {
      "parameters": {
        "jsCode": "// Dados originais da triagem (vêm do trigger)\nconst triagem = $('Entrada dos Dados').first().json;\n\n// Resultado da busca do plano\nconst planoResult = $input.all();\nlet health_plan_id = null;\n\n// O HTTP Request retorna um array — se encontrou, pega o id\nif (planoResult.length > 0 && planoResult[0].json) {\n  const data = planoResult[0].json;\n  // Se o resultado é um array (resposta do Supabase)\n  if (Array.isArray(data)) {\n    if (data.length > 0) health_plan_id = data[0].id;\n  } else if (data.id) {\n    health_plan_id = data.id;\n  }\n}\n\nconst urgente = triagem.urgente === true || triagem.urgente === 'true';\n\nconst contactData = {\n  name: triagem.nome || 'não informado',\n  phone: triagem.telefone || 'não informado',\n  contact_type: 'lead',\n  solicitation_target: triagem.solicitation_target || 'voce_mesmo',\n  contact_reason: triagem.contact_reason || 'transtorno_mental_adulto',\n  funnel_stage: 'novo_contato',\n  notes: (urgente ? '[URGENTE] ' : '') + (triagem.resumo || '')\n};\n\nif (health_plan_id) {\n  contactData.health_plan_id = health_plan_id;\n}\n\nreturn [{ json: contactData }];"
      },
